    { "when": { "facing": "west" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_projector", "y": 270 } },
    { "when": { "facing": "up" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_projector", "x": 270 } },
    { "when": { "facing": "down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_projector", "x": 90 } },
    { "when": { "north": "wired" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_connection" } },
    { "when": { "east": "wired" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_connection", "y": 90 } },
    { "when": { "south": "wired" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_connection", "y": 180 } },
    { "when": { "west": "wired" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_connection", "y": 270 } },
    { "when": { "up": "wired" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_connection", "x": 270 } },
    { "when": { "down": "wired" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_connection", "x": 90 } },
    { "when": { "north": "support", "facing": "east|south|west|up|down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_blue" } },
    { "when": { "east": "support", "facing": "north|south|west|up|down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_blue", "y": 90 } },
    { "when": { "south": "support", "facing": "north|east|west|up|down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_blue", "y": 180 } },
    { "when": { "west": "support", "facing": "north|east|south|up|down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_blue", "y": 270 } },
    { "when": { "up": "support", "facing": "north|east|south|west|down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_blue", "x": 270 } },
    { "when": { "down": "support", "facing": "north|east|south|west|up" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_blue", "x": 90 } },
    { "when": { "north": "support", "facing": "north" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_green" } },
    { "when": { "east": "support", "facing": "east" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_green", "y": 90 } },
    { "when": { "south": "support", "facing": "south" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_green", "y": 180 } },
    { "when": { "west": "support", "facing": "west" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_green", "y": 270 } },
    { "when": { "up": "support", "facing": "up" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_green", "x": 270 } },
    { "when": { "down": "support", "facing": "down" }, "apply": { "model": "generallaymansaestheticspyingscreen:block/glass_support_green", "x": 90 } }
  ]
